module ActionView
  class Base
    @lookup_context: LookupContext?
    def form_with: () -> nil
    def lookup_context: () -> LookupContext
    def view_renderer: () -> nil
    def view_flow: () -> nil
    def controller: () -> nil
    def html_escape: (String text) -> String
    def asset_path: (String? source, ?skip_pipeline: bool, ?host: String?, ?protocol: (String | Symbol)?) -> String
    def asset_url: (String? source, ?skip_pipeline: bool, ?host: String?) -> String
    def asset_path_with: (String? source, bool skip_pipeline, String? host, (String | Symbol)? protocol) -> String
    def asset_host: (String host, (String | Symbol)? protocol) -> String
  end

  class OutputBuffer
    @raw_buffer: String
    def initialize: (?String buffer) -> void
    def to_s: () -> String
    def to_str: () -> String
    def length: () -> Integer
    def empty?: () -> bool
    def html_safe?: () -> bool
    def <<: (String? value) -> OutputBuffer
    def safe_concat: (String value) -> OutputBuffer
  end

  class LookupContext
    def variants: () -> Array[Symbol]
    def formats: () -> Array[Symbol]
  end
end
